# Copy this file to .env and fill in the values yourself.
# .env is git-ignored. Never commit it, and never paste these values into a chat.
# Nothing here is needed until Stage 5 (Sepolia). Stages 0 to 4 run on Anvil.

# Sepolia RPC endpoint from Alchemy or Infura (HTTPS)
SEPOLIA_RPC_URL=

# Private key of the project-only test wallet that deploys the contracts (with or without 0x).
# Use a fresh MetaMask account made for this project, never a personal wallet.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key, used to publish verified contract source
ETHERSCAN_API_KEY=

# The website reads its own settings from web/.env.local (optional). By default it uses a public Sepolia
# endpoint and the local ZK inbox, so nothing is needed there. To use your own endpoint instead:
#   NEXT_PUBLIC_SEPOLIA_RPC_URL=https://...
# Anything named NEXT_PUBLIC_ is visible to every visitor, so never put a private key there.
