# Dependencies
node_modules/

# Secrets: only .env.example is committed
.env
.env.*
!.env.example

# Circuit build output and trusted-setup files (rebuilt by scripts)
circuits/build/
*.ptau
*.zkey
# ...except the clearing circuit's proving key: it must match the committed ClearingVerifier.sol, and a new
# setup produces a different one (by design), so it is kept in the repository.
!circuits/keys/clearing.zkey

# Local chain deployments change on every run; Sepolia deployments are committed
deployments/31337.json
deployments/test-*.json

# Test and tool output
coverage/
*.log

# OS and editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
