pragma solidity 0.8.24;

import {Test} from "forge-std/Test.sol";
import {MockERC20} from "../../src/tokens/MockERC20.sol";
import {ObscuraBase} from "../../src/ObscuraBase.sol";
import {ObscuraAuction} from "../../src/ObscuraAuction.sol";

/// @notice The contract must hash orders exactly as the TypeScript side does (packages/shared/src/order.ts).
///         The vectors are generated by TypeScript and checked here, and checked again by a TypeScript test,
///         so a change on either side breaks one of the two suites.
contract CommitmentVectorsTest is Test {
    function test_ContractMatchesTheTypeScriptVectors() public {
        ObscuraAuction auction = new ObscuraAuction(
            new MockERC20("TKN", "TKN"),
            new MockERC20("mUSD", "mUSD"),
            ObscuraBase.Config(5, 3, 3, 0.01 ether, 1 ether, 10e18, 64, 4)
        );
        string memory json = vm.readFile("test/vectors/commitments.json");
        address[] memory traders = vm.parseJsonAddressArray(json, ".traders");
        uint256[] memory epochs = vm.parseJsonUintArray(json, ".epochs");
        bool[] memory isBuys = vm.parseJsonBoolArray(json, ".isBuys");
        uint256[] memory limitPrices = vm.parseJsonUintArray(json, ".limitPrices");
        uint256[] memory amounts = vm.parseJsonUintArray(json, ".amounts");
        bytes32[] memory salts = vm.parseJsonBytes32Array(json, ".salts");
        bytes32[] memory hashes = vm.parseJsonBytes32Array(json, ".hashes");

        assertGt(traders.length, 0);
        for (uint256 i; i < traders.length; ++i) {
            bytes32 onChain = auction.commitmentHash(
                traders[i], epochs[i], isBuys[i], uint128(limitPrices[i]), uint128(amounts[i]), salts[i]
            );
            assertEq(onChain, hashes[i], string.concat("vector ", vm.toString(i)));
        }
    }
}
